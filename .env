# CFD3_AutoSystem 用サンプル環境変数ファイル
# 使い方: このファイルをコピーして `.env` にリネームし、実際の値を入れてください。
# セキュリティ: `.env` を作成したら `chmod 600 .env` を推奨します。

# --- SMTP (メール送信用) ---
# Gmail の場合: ALERT_EMAIL_HOST=smtp.gmail.com, ALERT_EMAIL_PORT=465
# ALERT_EMAIL_USER は送信元メールアドレス
ALERT_EMAIL_HOST=smtp.gmail.com
ALERT_EMAIL_PORT=465
ALERT_EMAIL_USER=furuta61@gmail.com
# メール送信用のパスワード。Gmail の場合は "アプリパスワード" を利用してください。
ALERT_EMAIL_PASS=ejnvyrrhfegvrrav
# メール送信先（通知先 iCloud/Gmail など）
ALERT_EMAIL_TO=furuta61@icloud.com

# --- Notification / webhook settings (changed for testing) ---
# Notify on: comma-separated signals. Use ALL to allow all notifications.
# If true, run IFD script automatically on webhook CSV append
# Text keywords scanned when signal is missing
NOTIFY_TEXT_KEYWORDS=STRONG_GO,GO,cross,交差,IFD
NOTIFY_ON=STRONG_GO
# WebhookでCSV追記後にIFDを自動実行
RUN_IFD_ON_WEBHOOK=true
# IFD実行モード: strict_4h / closed_60m / always / manual
IFD_RUN_MODE=closed_60m
# 時間帯ゲート（ローカル時刻・カンマ区切り）
IFD_SCHEDULE_WINDOWS=09:15,13:15,17:15,22:30
# タイムゾーン（JST）
IFD_SCHEDULE_TZ=Asia/Tokyo
# 許容前後分（±7分）
IFD_SCHEDULE_TOLERANCE_MIN=7
# スケジュール方針: gate=時間外はブロック / prefer=時間外も許可 / off=無効
IFD_SCHEDULE_POLICY=prefer

# --- Slack (任意) ---
# Slack 通知を使う場合は Webhook URL を指定します。コメントアウトしておくと無効になります。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# --- 動作設定 ---
# ログレベル: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- 追加/将来用のオプション（必要に応じてアンコメント） ---
# YF のシンボル上書きマップを環境変数で直接渡すのは面倒なので、必要なら `app/config.py` の YF_SYMBOL_OVERRIDES に追加してください。
# ここではサンプルとして空欄で示します。
# YF_SYMBOL_OVERRIDES="XAUUSD=XAUUSD,JP225=^N225"

# --- 備考 ---
# - このファイルは機密情報を含みます。リポジトリにコミットしないでください。
# - macOS + Gmail の場合、メール送信に失敗したら "アプリパスワード" を発行して `ALERT_EMAIL_PASS` に設定してください。
# - `.env` を読み込むスクリプトは `scripts/run_notify.sh` が想定されています。

NEWS_API_KEY=ea11c5863e534778a724912d98df0427
NEWS_COUNTRY=us     # 任意 (jp, us, gb など)
NEWS_CATEGORY=research

# --- 判定閾値設定: mygpt推奨パラメータ (ver.2025-11最適化) ---
# 
# 【目標】
# - 1日に1〜3銘柄のみGO以上になる程度
# - 買い/売りが混在する自然な分布（BUY:SELL = 60:40）
# - ニュースや変動率で適度にフィルタリング
#
# 【mygpt 推奨：高精度プロファイル】
# 目的: シグナルの誤検知を減らし、通知対象（STRONG_GO）の精度を高める保守的設定
# - ニュース/センチメント重みを強め、GO/STRONG_GO閾値を厳格化
# - 極端変動（大きな値動き）での誤判定を減らすためステップ閾値をやや厳しく設定
# 必要に応じてこのブロックを微調整してください（小さな変更→実行→評価を推奨）。
TECH_WEIGHT=0.55
NEWS_WEIGHT=0.60

# GO閾値: 高精度化のため引き上げ（誤検知を減らす）
GO_THRESHOLD=4.05

# STRONG_GO閾値: 厳格化（通知対象の精度優先）
STRONG_GO_THRESHOLD=4.75

# 極端変動ボーナス: 大きな変動に対する加点を厳格化（誤った急騰/急落での過剰評価を抑制）
EXTREME_MOVE_ON=1
EXTREME_MOVE_STEP1=2.5   # 2.5%変動で小補正
EXTREME_MOVE_STEP2=4.0   # 4%変動で中補正
EXTREME_MOVE_STEP3=6.0   # 6%変動で大補正
EXTREME_MOVE_ADJ1=0.25
EXTREME_MOVE_ADJ2=0.45
EXTREME_MOVE_ADJ3=0.90

# センチメント重み（ニュースの影響を強める）
SENTIMENT_LOCAL_WEIGHT=2.0

# 売買方向バランサー（値を下げて方向バイアスを抑制）
DIRECTION_BALANCER=0.10