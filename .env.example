## =============================================================
## CFD3_AutoSystem  .env.example
## -------------------------------------------------------------
## 使い方:
##   cp .env.example .env
##   （値を本番用に書き換え）
##   chmod 600 .env
## =============================================================

# --- 基本認証 / APIキー類 ---
OPENAI_API_KEY=sk-xxxx                    # OpenAI APIキー
TV_WEBHOOK_SECRET=your_tv_secret          # TradingView 連携用トークン

# --- 公開URL (FastAPI) ---
# Cloudflare Tunnel や VPS の公開URL。設定すると Streamlit で自動利用。
PUBLIC_BASE_URL=https://your-fastapi-host.trycloudflare.com

# --- データ/動作モード ---
DATA_DIR=./data
IFD_RUN_MODE=closed_60m                   # strict_4h / closed_60m / always / manual
IFD_TIMEFRAME=4h                          # 4h / 1h / 30m
IFD_SCHEDULE_WINDOWS=09:15,13:15,17:15,22:30
IFD_SCHEDULE_TOLERANCE_MIN=7
IFD_SCHEDULE_POLICY=prefer                # gate / prefer / off

# --- 通知設定 ---
NOTIFY_ON=STRONG_GO
NOTIFY_TEXT_KEYWORDS=STRONG_GO,GO,cross,交差,IFD

# --- Gmail (任意: メール通知を使う場合) ---
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your_app_password_here
GMAIL_TO=recipient1@example.com,recipient2@example.com

# --- Webhook トークン (旧互換) ---
WEBHOOK_TOKEN=changeme_token

# --- Uvicorn ポート (ローカルデバッグ用) ---
PORT=8080

# --- SMTP (メール送信用 代替) ---
ALERT_EMAIL_HOST=smtp.example.com
ALERT_EMAIL_PORT=465
ALERT_EMAIL_USER=you@example.com
ALERT_EMAIL_PASS=your_email_app_password_here
ALERT_EMAIL_TO=your@icloud.com

# --- Slack (任意) ---
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/XXXX/XXXX

# --- ログレベル ---
LOG_LEVEL=INFO

# --- ニュースAPI (任意) ---
# NEWS_API_KEY=your_newsapi_key_here

# --- 判定チューニング (必要ならアンコメント) ---
# TECH_WEIGHT=0.6
# NEWS_WEIGHT=0.4
# GO_THRESHOLD=3.8
# STRONG_GO_THRESHOLD=5.5
# SENTIMENT_LOCAL_WEIGHT=1.5

# --- 極端変動ボーナス (任意) ---
# EXTREME_MOVE_ON=1
# EXTREME_MOVE_STEP1=2.0
# EXTREME_MOVE_STEP2=3.0
# EXTREME_MOVE_STEP3=5.0
# EXTREME_MOVE_ADJ1=0.3
# EXTREME_MOVE_ADJ2=0.5
# EXTREME_MOVE_ADJ3=1.0

# --- ブローカー価格表示調整 (例) ---
# BROKER_PRICE_US30=47472.3
# BROKER_SCALE_US30=1.376008695652
# BROKER_PRICE_XAUUSD=4124.6

# --- 備考 ---
# ・機密情報(.env)は Git にコミットしない
# ・本番運用ではログローテーション/監視を導入推奨

# --- SMTP (メール送信用) ---
# Gmail の場合: ALERT_EMAIL_HOST=smtp.gmail.com, ALERT_EMAIL_PORT=465
# ALERT_EMAIL_USER は送信元メールアドレス
ALERT_EMAIL_HOST=smtp.example.com
ALERT_EMAIL_PORT=465
ALERT_EMAIL_USER=you@example.com
# メール送信用のパスワード。Gmail の場合は "アプリパスワード" を利用してください。
ALERT_EMAIL_PASS=your_email_app_password_here
# メール送信先（通知先 iCloud/Gmail など）
ALERT_EMAIL_TO=your@icloud.com

# --- Slack (任意) ---
# Slack 通知を使う場合は Webhook URL を指定します。コメントアウトしておくと無効になります。
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX

# --- 動作設定 ---
# ログレベル: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- NewsAPI (ニュース取得/センチメント用・任意) ---
# `app/news_collector.py` は NewsAPI を利用してニュースを収集します。
# ここが未設定の場合、ニュース取得はスキップされます（ログに "NEWS_API_KEY not set. Skipping news fetch." と表示）。
# API キーの取得: https://newsapi.org/
# NEWS_API_KEY=your_newsapi_key_here

# --- 判定チューニング（任意・上書き用） ---
# 重み（既定: TECH_WEIGHT=0.6, NEWS_WEIGHT=0.4）
# TECH_WEIGHT=0.6
# NEWS_WEIGHT=0.4
# 閾値（既定: GO=3.8, STRONG_GO=5.5）
# GO_THRESHOLD=3.8
# STRONG_GO_THRESHOLD=5.5
# ニュースのセンチメント寄与（既定: 1.5）
# SENTIMENT_LOCAL_WEIGHT=1.5

# --- 極端変動ボーナス（任意・上書き用） ---
# 有効化: EXTREME_MOVE_ON=1
# 閾値（%）: 2→+0.3, 3→+0.5, 5→+1.0（既定）
# EXTREME_MOVE_ON=1
# EXTREME_MOVE_STEP1=2.0
# EXTREME_MOVE_STEP2=3.0
# EXTREME_MOVE_STEP3=5.0
# EXTREME_MOVE_ADJ1=0.3
# EXTREME_MOVE_ADJ2=0.5
# EXTREME_MOVE_ADJ3=1.0

# --- 追加/将来用のオプション（必要に応じてアンコメント） ---
# YF のシンボル上書きマップを環境変数で直接渡すのは面倒なので、必要なら `app/config.py` の YF_SYMBOL_OVERRIDES に追加してください。
# ここではサンプルとして空欄で示します。
# YF_SYMBOL_OVERRIDES="XAUUSD=XAUUSD,JP225=^N225"

# --- Broker display price overrides (GMOなどのブローカー表示に合わせる) ---
# もしブローカーが内部の価格スケールと異なる場合、ここで銘柄ごとのブローカー表示価格か
# スケール係数を与えて出力をブローカー表示に合わせられます。フォーマット:
#   BROKER_PRICE_<INSTR>=<broker_display_price>
#   BROKER_SCALE_<INSTR>=<scale_factor>
# 例: US30 の表示を 47472.3 に合わせたい場合 (以前の例):
#   BROKER_PRICE_US30=47472.3
#   # または既知の scale を直接設定
#   BROKER_SCALE_US30=1.376008695652
# ゴールドの扱い: 当リポジトリでは XAUUSD / GOLD / TVC_GOLD 等の複数ソースが混在します。
# GMO の表示 (GC=F / TVC_GOLD) に統一したい場合、TVC_GOLD に対応する CSV の最終価格を
# BROKER_PRICE_XAUUSD に設定してください (例: BROKER_PRICE_XAUUSD=4124.6)


# END