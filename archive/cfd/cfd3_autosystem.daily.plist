<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cfd3.autosystem.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/otomi/Desktop/CFD3_AutoSystem/.venv/bin/python3</string>
    <string>/Users/otomi/Desktop/CFD3_AutoSystem/bin/daily_monitor.py</string>
