# keyring.set_password('CFD3_MAIL', 'you@example.com', '<app-password>')


def load_email_credentials():
    """Load email credentials from env/keyring. Returns (from_addr, to_addr, password) or (None, None, None)."""
    from_addr = os.environ.get('CFD3_FROM')
    to_addr = os.environ.get('CFD3_TO')
    pwd = None
    if from_addr:
        try:
            pwd = keyring.get_password('CFD3_MAIL', from_addr)
        except Exception:
            if __name__ == '__main__':
                main()

