# ===============================
# ハイブリッドスコア v116
# ===============================
def hybrid_score_v116(symbol, t30, t240, news):
    tech_score = 0

    # RSI
    if t30["rsi"] > 70: tech_score -= 10
    elif t30["rsi"] < 30: tech_score += 10

    # SMA
    if t30["close"] > t30["sma25"] > t30["sma75"]:
        tech_score += 10
    if t240["close"] > t240["sma25"]:
        tech_score += 10
    else:
        tech_score -= 10

    # MACD
    tech_score += (10 if t30["macd"] > t30["signal"] else -10)

    # ニュース
    news_score = (news["positive"] - news["negative"]) / 2 + news["risk_score"] / 5

    total = tech_score * 0.6 + news_score * 0.4
    return round(total, 1)

def score_to_label(score):
    if score >= 40: return "STRONG_GO"
    if score >= 15: return "GO"
    if score >= -10: return "HOLD"
    if score >= -30: return "STOP"
    return "STRONG_STOP"

