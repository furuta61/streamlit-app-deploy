def generate_market_comment(r):
    """Unified解析結果から、市況分析コメントを自動生成する（ローカル簡易AI）"""

    symbol = r.get("symbol")

    # 値の取得（t30優先、無ければ大文字キーも見る）
    t30 = r.get("t30", {}) or {}
    rsi = float(t30.get("rsi", r.get("RSI", 0)) or 0)
    sma25 = float(t30.get("sma25", r.get("SMA25", 0)) or 0)
    sma75 = float(t30.get("sma75", r.get("SMA75", 0)) or 0)
    macd = float(t30.get("macd", r.get("MACD", 0)) or 0)
    signal = float(t30.get("signal", r.get("Signal", 0)) or 0)

    news = r.get("news", {}) or {}
    pos = float(r.get("sentiment_pos", news.get("positive", 30)) or 30)
    neu = float(r.get("sentiment_neutral", news.get("neutral", 50)) or 50)
    neg = float(r.get("sentiment_neg", news.get("negative", 20)) or 20)

    comments = []

    # --- トレンド判定 ---
    if sma25 > sma75:
        comments.append("短期的に上昇トレンドが優勢で、買いの勢いが続きやすい状態です。")
    elif sma25 < sma75:
        comments.append("短期トレンドは下向きで、戻り売りが入りやすい展開です。")
    else:
        comments.append("トレンドは横ばいで方向感に乏しい状況です。")

    # --- 過熱感（RSI） ---
    if rsi >= 70:
        comments.append("RSIが70を超えており高値圏に近く、短期的な調整には注意が必要です。")
    elif rsi <= 30:
        comments.append("RSIが30以下で売られすぎ圏にあり、反発が入りやすい位置です。")

    # --- モメンタム（MACD） ---
    if macd > signal:
        comments.append("MACDがシグナルを上回っており、モメンタムは改善傾向にあります。")
    elif macd < signal:
        comments.append("MACDがシグナルを下回り、勢いはやや弱く下方向リスクがあります。")

    # --- ニュース感情 ---
    if pos > neg:
        comments.append("ニュースはポジティブ寄りで、市場を下支えする要因になっています。")
    elif neg > pos:
        comments.append("ニュースはネガティブ寄りで、市場の重しになりやすい状況です。")
    else:
        comments.append("ニュースは中立的で、相場への影響は限定的です。")

    # --- 総合判断 ---
    if sma25 < sma75 and macd < signal:
        comments.append("総合的には弱含みで、急反落には注意が必要です。")
    elif sma25 > sma75 and macd > signal:
        comments.append("総合的には強気継続で、押し目買いが機能しやすい局面です。")
    else:
        comments.append("強弱が入り混じり、短期的な値動きに振られやすい相場です。")

    return {
        "symbol": symbol,
        "comment": " ".join(comments)
    }


# ===============================
#  異常値フィルタ
# ===============================
def clean_dataframe(df, symbol=""):
    """
    TradingView CSV のインジケータ列を無視し、
    基本的なOHLCデータだけを保持する
    """
    df = df.copy()
    
    # 必要な列だけ確認
    required = ["time", "open", "high", "low", "close"]
    
    # 列が存在するかチェック
    for col in required:
        if col not in df.columns:
            # カラム名の大文字小文字を無視して探す
            found = False
            for c in df.columns:
                if c.lower() == col.lower():
                    df.rename(columns={c: col}, inplace=True)
                    found = True
                    break
            if not found:
                raise ValueError(f"{symbol}: CSVに必要な列 '{col}' がありません")
    
    # 必要な列のみ抽出（インジケータ列を無視）
    df = df[required]
    
    # 数値型に変換
    for col in ["open", "high", "low", "close"]:
        df[col] = pd.to_numeric(df[col], errors="coerce")
    
    # ★ OHLC の NaN だけ削除（インジは無視）
    df = df.dropna(subset=["open", "high", "low", "close"])
    
    # ★ 明らかに異常な価格だけ除外（0以下のみ）
    df = df[(df["open"] > 0) & (df["high"] > 0) & (df["low"] > 0) & (df["close"] > 0)]
    
    # 時間順にソート
    if "time" in df.columns:
        df = df.sort_values("time").reset_index(drop=True)
    
    return df

