def get_tp_sl_distribution(row):
    """TP1/TP2/SL 到達確率を返す"""
    if tp_sl_model is None:
        return {-1:0.33, 0:0.33, 1:0.33, 2:0.33}  # フォールバック

    features = [
        "RSI", "SMA25", "SMA75", "MACD", "Signal",
        "sentiment_pos", "sentiment_neg"
    ]
    X = pd.DataFrame([[row[f] for f in features]], columns=features)

    try:
        preds = tp_sl_model.predict_proba(X)[0]
        labels = tp_sl_model.classes_
        return {int(l): float(p) for l, p in zip(labels, preds)}
    except Exception as e:
        print(f"[WARN] TP/SL確率 計算失敗: {e}")
        return {-1:0.33, 0:0.33, 1:0.33, 2:0.33}

# ===============================
# GMOベースIFD計算ロジック（ハイブリッド完全版）
# ===============================
def build_ifd_from_hybrid(symbol, tech, news, gmo_mid):
    """
    GMO現在値とテクニカル/ニュースからIFDを計算
    symbol: "JP225" など
    tech:   calc_tech() + unified の結果（SMA/RSI/ATRなど + direction/score）
    news:   ニュース評価
    gmo_mid: GMO 現在ミッド価格
    """
    tick = TICK[symbol]
    
    # --- 方向判定（GO / HOLD ロジックに対応） ---
    direction = tech.get("direction", "stay")  # "buy" / "sell" / "stay"
    ai_score  = tech.get("score", 0.5)
    ai_judge  = "GO" if direction in ("buy", "sell") else "HOLD"
    
    # ---- stay の場合：価格は全部同じ ----
    if direction == "stay":
        entry = round_to_tick(gmo_mid, tick)
        return {
            "direction": "stay",
            "entry": entry,
            "sl": entry,
            "tp1": entry,
            "tp2": entry,
            "order_type": "指値",
            "judge": "HOLD",
            "stars": "★☆☆☆☆",
            "ai_score": ai_score,
            "ai_judge": ai_judge,
        }
    
    # --- ATR が0 のときは最低値を補正 ---
    atr = tech.get("atr", 0)
    if atr <= 0:
        atr = max(abs(tech["close"]) * 0.001, 100)  # fallback
    
    # --- リスク係数（必要なら調整可能） ---
    risk_k = 1.5
    tp1_k  = 1.5
    tp2_k  = 3.0
    
    entry = round_to_tick(gmo_mid, tick)
    
    if direction == "buy":
        sl  = round_to_tick(entry - risk_k * atr, tick)
        tp1 = round_to_tick(entry + tp1_k * atr, tick)
        tp2 = round_to_tick(entry + tp2_k * atr, tick)
    
    elif direction == "sell":
        sl  = round_to_tick(entry + risk_k * atr, tick)
        tp1 = round_to_tick(entry - tp1_k * atr, tick)
        tp2 = round_to_tick(entry - tp2_k * atr, tick)
    
    stars = "★★★★★" if ai_score >= 0.7 else "★★★☆☆"
    
    return {
        "direction": direction,
        "entry": entry,
        "sl": sl,
        "tp1": tp1,
        "tp2": tp2,
        "order_type": "指値",
        "judge": "GO",
        "stars": stars,
        "ai_score": ai_score,
        "ai_judge": ai_judge,
    }

