def analyze_news_sentiment(symbol, items):
    if not isinstance(items, list):
        items = []

    text_block = "\n".join(items[:5]) if items else f"{symbol} の関連ニュースなし"

    prompt = f"""
あなたは金融アナリストです。
このニュース内容から {symbol} の感情を JSON で返してください:

{{
 "positive": 0-100,
 "neutral": 0-100,
 "negative": 0-100,
 "risk_score": -100〜100,
 "summary": "50文字以内"
}}

ニュース:
{text_block}
"""
    try:
        res = client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[{"role": "user", "content": prompt}],
            temperature=0.4
        )
        raw = res.choices[0].message.content.strip()

        if "```" in raw:
            m = re.search(r"\{.*\}", raw, re.DOTALL)
            if m:
                raw = m.group(0)

        data = json.loads(raw)
        return safe_news_dict(data)
    except:
        return safe_news_dict(None)


