def safe_news_dict(news):
    if isinstance(news, dict):
        for k in ["positive", "neutral", "negative", "risk_score", "summary"]:
            news.setdefault(k, 0 if k != "summary" else "なし")
        return news
    return {
        "positive": 30,
        "neutral": 40,
        "negative": 30,
        "risk_score": 0,
        "summary": "ニュースなし"
    }

