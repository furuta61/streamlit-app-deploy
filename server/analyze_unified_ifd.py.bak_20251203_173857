def save_dawn_results(unified_results, path="dawn_results.csv"):
    """
    Dawn形式の生データ（unified_results）を CSV に自動保存する。
    ・列順固定
    ・(symbol + entry_time) の組を unique key にして重複防止
    """

    df_new = pd.DataFrame(unified_results).copy()

    # entry_time を文字列へ統一
    if "entry_time" in df_new.columns:
        df_new["entry_time"] = df_new["entry_time"].astype(str)

    # 列順（統一フォーマット）
    column_order = [
        "symbol", "方向", "判定", "entry_price", "SL", "TP1", "TP2",
        "order_type", "ニュースロック", "推奨度", "ロット", "CUT条件",
        "RSI", "SMA25", "SMA75", "MACD", "Signal",
        "sentiment_pos", "sentiment_neg",
        "AI_Score", "AI_Judge", "AI_TP1", "AI_TP2", "AI_SL",
        "AI_TP1_Prob", "AI_TP2_Prob", "AI_SL_Prob",
        "entry_time"
    ]

    # 存在する列だけで順序を合わせる
    df_new = df_new[[c for c in column_order if c in df_new.columns]]

    # 既存ファイルの読み込み
    if os.path.exists(path):
        try:
            df_old = pd.read_csv(path)
        except Exception:
            df_old = pd.DataFrame(columns=column_order)

        # 列順を揃える
        df_old = df_old[[c for c in column_order if c in df_old.columns]]

        # 結合
        df_combined = pd.concat([df_old, df_new], ignore_index=True)

        # ★ 重複排除（symbol + entry_time）
        if "symbol" in df_combined.columns and "entry_time" in df_combined.columns:
            df_combined = df_combined.drop_duplicates(subset=["symbol", "entry_time"], keep="last")
    else:
        df_combined = df_new.copy()

    # 保存
    df_combined.to_csv(path, index=False, encoding="utf-8")
    print(f"[INFO] Dawn結果を {path} に保存（列順固定・重複排除済み）")

