# ===============================
# Dawn形式 IFD 生成コード（完全版）
# ===============================
def convert_to_dawn_format(result):
    """Unified解析結果1銘柄分 → Dawn形式に変換"""

    判定 = result.get("label", "HOLD")
    score = float(result.get("score", 0))
    t30 = result.get("t30", {})
    t240 = result.get("t240", {})

    # Dawn方向変換
    if 判定 in ["STRONG_GO", "GO"]:
        direction = "buy"
    elif 判定 in ["STOP", "STRONG_STOP"]:
        direction = "sell"
    else:
        direction = "stay"

    # ★スコア → ★★★★★ へ変換
    def score_to_stars(s):
        if s >= 20: return "★★★★★"
        if s >= 15: return "★★★★☆"
        if s >= 10: return "★★★☆☆"
        if s >= 5:  return "★★☆☆☆"
        if s >= 1:  return "★☆☆☆☆"
        return "☆☆☆☆☆"

    # ロット計算（あなたのルール：score / 3）
    lots = max(1, round(abs(score) / 3))

    # CUT条件
    SMA25 = t30.get("sma25")
    SMA75 = t30.get("sma75")
    MACD  = t30.get("macd")
    Signal = t30.get("signal")

    cut_list = []
    if SMA25 is not None and SMA75 is not None and SMA25 < SMA75:
        cut_list.append("SMA25<SMA75")
    if MACD is not None and Signal is not None and MACD < Signal:
        cut_list.append("MACD<Signal")

    cut_cond = " or ".join(cut_list) if cut_list else "none"

    return {
        "trade_mode": "DAY6H",  # 統一でOK（必要なら可変にできる）
        "銘柄": result.get("symbol"),
        "方向": direction,
        "entry_price": round(result.get("entry", 0), 1),
        "SL": round(result.get("sl", 0), 1),
        "TP1": round(result.get("tp1", 0), 1),
        "TP2": round(result.get("tp2", 0), 1),
        "order_type": "指値",
        "判定": 判定,
        "ニュースロック": "false",
        "推奨度": score_to_stars(score),
        "ロット": lots,
        "CUT条件": cut_cond
    }


