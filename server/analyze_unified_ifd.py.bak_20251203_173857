def fetch_news():
    urls = [
        "https://www.cnbc.com/id/100003114/device/rss/rss.html",
        "https://feeds.a.dj.com/rss/RSSMarketsMain.xml",
        "https://news.google.com/rss/search?q=Nikkei225+NASDAQ+Gold+DAX+site:reuters.com"
    ]
    items = []
    for u in urls:
        try:
            f = feedparser.parse(u)
            for e in f.entries[:5]:
                items.append(f"{e.title} {getattr(e,'summary','')}")
        except:
            pass
    return items[:10]

