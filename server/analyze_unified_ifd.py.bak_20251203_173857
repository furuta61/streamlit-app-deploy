            f"{c['推奨度']} | {c['ロット']} | {c['CUT条件']} | "
            f"{r.get('AI_Score', '')} | {r.get('AI_Judge', '')} | "
            f"{r.get('AI_TP1', '')} | {r.get('AI_TP2', '')} | {r.get('AI_SL', '')}"
        )
        rows.append(line)

    return header + "\n" + "\n".join(rows)


# ===============================
# メイン統合処理
# ===============================
def analyze_unified_ifd(symbols=["日本225","米国NQ100ミニ","ドイツ40","金スポット"], mode="swing", screenshot_data=None):
    """
    統合IFD生成＋DawnAI適用
    mode='swing': CSV→テクニカル→IFD
    mode='screenshot': screenshot_data={'symbol':str, 'entry':float, 'sl':float, 'tp1':float, 'tp2':float}からIFD
    """
    news_items = fetch_news()
    results = []
    
    # スクショモード: 単一銘柄処理
    if mode == "screenshot" and screenshot_data:
        symbols = [screenshot_data.get("symbol")]
    
    for sym in symbols:
        try:
            # --- スクショモード: 外部からIFD値を受け取る ---
            if mode == "screenshot" and screenshot_data:
                code = SYMBOL_MAP.get(sym, sym)
                f30 = BASE_DIR / "data" / f"FOREXCOM_{code}_30.csv"
                f240 = BASE_DIR / "data" / f"FOREXCOM_{code}_240.csv"

                df240 = pd.read_csv(f240)
                df240 = clean_dataframe(df240, sym)
                t240 = calc_tech(df240, symbol=sym)

                df30 = pd.read_csv(f30)
                df30 = clean_dataframe(df30, sym)
                t30 = calc_tech(df30, symbol=sym)

                news = analyze_news_sentiment(sym, news_items)
                news = safe_news_dict(news)

                # スクショからのIFD値を使用
                entry = float(screenshot_data.get("entry", 0))
                sl = float(screenshot_data.get("sl", entry))
                tp1 = float(screenshot_data.get("tp1", entry))
                tp2 = float(screenshot_data.get("tp2", entry))
                
                # 方向判定
                if tp1 > entry:
                    label = "GO"
                elif tp1 < entry:
                    label = "STOP"
                else:
                    label = "HOLD"
                
                score = 10  # スクショモードは固定スコア
                
            else:
                # --- 通常スイングモード: CSV→テクニカル→GMOベースIFD ---
                code = SYMBOL_MAP.get(sym, sym)
                f30 = BASE_DIR / "data" / f"FOREXCOM_{code}_30.csv"
                f240 = BASE_DIR / "data" / f"FOREXCOM_{code}_240.csv"

                df240 = pd.read_csv(f240)
                df240 = clean_dataframe(df240, sym)
                t240 = calc_tech(df240, symbol=sym)

                df30 = pd.read_csv(f30)
                df30 = clean_dataframe(df30, sym)
                t30 = calc_tech(df30, symbol=sym)

                news = analyze_news_sentiment(sym, news_items)
                news = safe_news_dict(news)

                score = hybrid_score_v116(sym, t30, t240, news)
                label = score_to_label(score)
                
                # GMO現在値を取得（銘柄マッピング）
                gmo_symbol = code  # JP225, NAS100, GER40
                if sym == "金スポット":
                    gmo_symbol = "XAUUSD"
                
                # ハイブリッドIFD変数初期化
                hybrid = None
                
                # GMO現在値がある場合はIFD再計算
                if gmo_symbol in gmo_prices:
                    gmo_mid = mid_price(gmo_prices[gmo_symbol])
                    
                    # 方向判定
                    if label in ["STRONG_GO", "GO"]:
                        direction = "buy"
                    elif label in ["STOP", "STRONG_STOP"]:
                        direction = "sell"
                    else:
                        direction = "stay"
                    
                    # tech30 / tech240 を組み合わせた unified データ
                    atr = (t30["atr"] + t240["atr"]) / 2
                    unified = {
                        "direction": direction,
                        "score": score / 100,  # 0-100 を 0-1 に正規化
                        "close": t30["close"],
                        "atr": atr,
                    }
                    
                    # GMOハイブリッド IFD作成
                    hybrid = build_ifd_from_hybrid(gmo_symbol, unified, news, gmo_mid)
                    
                    entry = hybrid["entry"]
                    sl = hybrid["sl"]
                    tp1 = hybrid["tp1"]
                    tp2 = hybrid["tp2"]
                else:
                    # GMO価格がない場合は従来ロジック
                    entry = (t30["close"] + t240["close"]) / 2
                    atr = (t30["atr"] + t240["atr"]) / 2

                    if label in ["STRONG_GO", "GO"]:
                        sl = entry - atr
                        tp1 = entry * 1.002
                        tp2 = entry * 1.004
                    elif label in ["STOP", "STRONG_STOP"]:
                        sl = entry + atr
                        tp1 = entry * 0.998
                        tp2 = entry * 0.996
                    else:
                        sl = tp1 = tp2 = entry

            # --- 取引用 Markdown 作成 ---
            trade_md = build_trade_markdown(
                symbol=sym, t30=t30, t240=t240, score=score, label=label,
                entry=entry, sl=sl, tp1=tp1, tp2=tp2
            )

            # --- 通常 Markdown（ニュースそのまま） ---
            detail_md = f"""
| モード | 銘柄 | 判定 | entry | SL | TP1 | TP2 | スコア |
|--------|------|------|-------|------|------|------|--------|
| Unified | {sym} | {label} | {entry:.1f} | {sl:.1f} | {tp1:.1f} | {tp2:.1f} | {score} |

### 📊 テクニカル
RSI={t30['rsi']:.1f} / SMA25={t30['sma25']:.1f} / SMA75={t30['sma75']:.1f}

### 📰 ニュース感情
🟢{news['positive']}% ⚪️{news['neutral']}% 🔴{news['negative']}%  
リスク: {news['risk_score']}  
要約: {news['summary']}
"""

            results.append({
                "symbol": sym,
                "markdown": detail_md,
                "trade_markdown": trade_md,
                # Dawn形式用データ
                "label": label,
                "score": score,
                "entry": entry,
                "sl": sl,
                "tp1": tp1,
                "tp2": tp2,
                # CSV保存用に変換後の列も追加
                "方向": hybrid["direction"] if hybrid else ("buy" if label in ["STRONG_GO","GO"] else ("sell" if label in ["STOP","STRONG_STOP"] else "stay")),
                "判定": hybrid["judge"] if hybrid else label,
                "entry_price": entry,
                "SL": sl,
                "TP1": tp1,
                "TP2": tp2,
                "order_type": hybrid["order_type"] if hybrid else "指値",
                "ニュースロック": "false",
                "推奨度": hybrid["stars"] if hybrid else ("★★★" if score >= 20 else "★★☆" if score >= 10 else "★☆☆"),
                "ロット": max(1, round(abs(score) / 3)),
                "CUT条件": f"SMA25<SMA75" if t30.get("sma25",0) < t30.get("sma75",0) else "none",
                # 4Hの最新足タイムスタンプを entry_time として付与
                "entry_time": (
                    pd.to_datetime(df240["time"].iloc[-1]) if "time" in df240.columns else df240.index[-1]
                ),
                "t30": t30,
                "t240": t240,
                "AI_Score": hybrid["ai_score"] if hybrid else 0.5,
                "AI_Judge": hybrid["ai_judge"] if hybrid else "HOLD",
                "news": news,
                # テクニカル・感情を保存（AIスコア用）
                "RSI": t30.get("rsi"),
                "SMA25": t30.get("sma25"),
                "SMA75": t30.get("sma75"),
                "MACD": t30.get("macd"),
                "Signal": t30.get("signal"),
                "sentiment_pos": news.get("positive"),
                "sentiment_neg": news.get("negative")
            })

        except Exception as e:
            results.append({
                "symbol": sym,
                "markdown": f"⚠️ {sym} エラー: {e}",
                "trade_markdown": f"⚠️ {sym} trade 作成不可: {e}"
            })
    
    # AIスコア付与とAI判定、TP/SL最適化AI
    for r in results:
        # -------- AIスコア (方向性) --------
        # hybridから既に設定済みの場合（0.5以外）はスキップ
        existing_score = r.get("AI_Score")
        if existing_score is None or existing_score == 0.5:
            ai_score = get_ai_score(r)
            r["AI_Score"] = round(ai_score, 3)
            if ai_score >= 0.65:
                r["AI_Judge"] = "GO"
            elif ai_score >= 0.50:
                r["AI_Judge"] = "HOLD"
            else:
                r["AI_Judge"] = "NG"

        # -------- TP/SL 最適化AI --------
        dist = get_tp_sl_distribution(r)
        tp1_p = dist.get(1, 0)
        tp2_p = dist.get(2, 0)
        sl_p  = dist.get(-1, 0)

        r["AI_TP1_Prob"] = round(tp1_p, 3)
        r["AI_TP2_Prob"] = round(tp2_p, 3)
        r["AI_SL_Prob"]  = round(sl_p, 3)

        entry = float(r.get("entry", 0.0))
        tp1_d = abs(r.get("tp1", entry) - entry)
        tp2_d = abs(r.get("tp2", entry) - entry)
        sl_d  = abs(entry - r.get("sl", entry))

        # ------------- 最適化ロジック（軽量版） -------------
        # AI_TP1 = 元TP1 × (1 + TP1確率)
        # AI_TP2 = 元TP2 × (1 + TP2確率)
        # AI_SL  = 元SL  × (1 - SL確率)

        r["AI_TP1"] = entry + tp1_d * (1 + tp1_p)
        r["AI_TP2"] = entry + tp2_d * (1 + tp2_p)
        r["AI_SL"]  = entry - sl_d  * (1 - sl_p)

        r["AI_TP1"] = round(r["AI_TP1"], 1)
        r["AI_TP2"] = round(r["AI_TP2"], 1)
        r["AI_SL"]  = round(r["AI_SL"], 1)

    market_reports = []
    for r in results:
        rep = generate_market_comment(r)
        rep["ai_score"] = r.get("AI_Score")
        rep["ai_judge"] = r.get("AI_Judge")
        market_reports.append(rep)

    # Dawn形式テーブル生成
    dawn_table = build_dawn_table(results)

    # Dawn の生データを CSV に自動保存
    try:
        save_dawn_results(results)
    except Exception as _e:
        # 保存失敗は致命ではないため無視
        pass
    
    return {
        "status": "ok",
        "count": len(results),
        "results": results,
        "dawn_table": dawn_table,
        "market_reports": market_reports
    }
